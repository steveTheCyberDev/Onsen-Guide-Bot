OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
RAKUTEN_APP_ID=your_rakuten_app_id_here
RAKUTEN_ACCESS_KEY=your_rakuten_access_key_here
RAKUTEN_HOTEL_URL=rakuten_base_api_url
# Shared secret the frontend must send as the X-API-Key header on /chat and /hotels.
# Must match the frontend's VITE_API_KEY. Generate one with: openssl rand -hex 32
API_KEY=your_backend_api_key_here

# --- Hotel name/detail JA→EN translation (rollout gate, OFF by default) ---
# When false (default) Rakuten hotels are returned with their original Japanese
# text exactly as today — no LLM call, no cache. Set true to translate each hotel's
# name/details to English once (gpt-4o-mini) and cache the result by Rakuten hotel
# id (fail-soft: any error falls back to Japanese). Applies to /hotels, /chat, and
# the trip planner alike.
HOTEL_TRANSLATION_ENABLED=false
HOTEL_TRANSLATION_MODEL=gpt-4o-mini
# Optional: SQLAlchemy URL for the hotel-translation cache. Leave unset to reuse the
# chat session DB (SESSION_DB_URL / the local sessions.db). Set it in prod to split
# the non-PII hotel cache onto its own DB and avoid write-lock contention with the
# per-user chat-session store, e.g. postgresql+psycopg://user:pass@host/hotel_cache
HOTEL_TRANSLATION_DB_URL=

# --- LangSmith step-level tracing (optional, OFF by default) ---
# Captures per-request latency, LLM calls, and token usage for the workflow
# engine so cost/latency can be measured and sliced by mode in the LangSmith UI.
# Leave these unset/false and the app runs exactly as before (zero tracing,
# no LangSmith calls). To turn tracing ON, set LANGSMITH_TRACING=true and provide
# an API key from https://smith.langchain.com (Settings -> API Keys).
# Modern LANGSMITH_* names are shown; the legacy LANGCHAIN_TRACING_V2 /
# LANGCHAIN_API_KEY / LANGCHAIN_PROJECT / LANGCHAIN_ENDPOINT aliases also work.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=onsen-guide-bot
# US SaaS endpoint by default; use https://eu.api.smith.langchain.com for the EU region.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
